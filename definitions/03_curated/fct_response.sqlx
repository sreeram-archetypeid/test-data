config {
  type: "incremental",
  schema: "banner",
  name: "fct_response",
  description: "One row per respondent x run x question x punch. Carries option_code AND option_label; the previous pipeline stripped the code for SELECT questions, which made every response-based banner cut inexpressible.",
  uniqueKey: ["study_id","respondent_id","run_id","question_key","option_code","option_label"],
  bigquery: { clusterBy: ["study_id","meta"] },
  tags: ["curated"]
}

js { const { CONFIG, BUILD_QUEUE, inQueue, PARSE_INT, PUNCH_CODE, PUNCH_LABEL } = require("includes/constants"); }

pre_operations {
  ${when(incremental(), `DELETE FROM ${self()} WHERE ${inQueue(self())}`, `SELECT 1`)}
}

WITH a AS (
  SELECT s.* EXCEPT (item_text), q.question_key, q.item_text, q.n_items
  FROM ${ref("stg_answer")} AS s
  JOIN ${ref("dim_question")} AS q
    ON q.study_id = s.study_id
   AND q.question_key = TO_HEX(MD5(CONCAT(IFNULL(s.meta,''),'||',s.question_text)))
  WHERE s.study_id IN (${BUILD_QUEUE})
),

-- Multi-punch cells are pipe-delimited; explode keeping each punch code.
-- Both prefix shapes occur in the source: '2. 2. Probably interested'
-- and '1. Action-packed'.
selected AS (
  SELECT
    a.study_id, a.format_id, a.respondent_id, a.run_id, a.source_file, a.cell_label,
    a.question_key, a.meta, a.question_text, a.item_text,
    a.tabulation_kind, a.response_mode, a.col_ordinal,
    ${PUNCH_CODE('piece')}  AS option_code,
    ${PUNCH_LABEL('piece')} AS option_label
  FROM a, UNNEST(SPLIT(IFNULL(a.selected_raw, ''), '|')) AS piece
  WHERE a.value_field = 'selected' AND TRIM(piece) != ''
),

-- Type 2: bare unlabelled number. Label comes from config if supplied,
-- otherwise the code itself is the stub.
rated AS (
  SELECT
    a.study_id, a.format_id, a.respondent_id, a.run_id, a.source_file, a.cell_label,
    a.question_key, a.meta, a.question_text, a.item_text,
    a.tabulation_kind, a.response_mode, a.col_ordinal,
    ${PARSE_INT('a.rating_raw')} AS option_code,
    IFNULL(rl.label, TRIM(a.rating_raw)) AS option_label
  FROM a
  LEFT JOIN ${CONFIG}.rating_label_map AS rl
    ON rl.format_id = a.format_id AND rl.meta = a.meta
   AND rl.code = ${PARSE_INT('a.rating_raw')}
  WHERE a.value_field = 'rating' AND a.rating_raw IS NOT NULL
),

unioned AS (
  SELECT * FROM selected UNION ALL SELECT * FROM rated
),

-- Primary run selection is configured, not an arbitrary filename sort.
-- The old QUALIFY ... ORDER BY source_file silently discarded half of a
-- designed replicate.
ranked AS (
  SELECT u.*, r.primary_run_rule,
    ROW_NUMBER() OVER (
      PARTITION BY u.study_id, u.respondent_id, u.question_key
      ORDER BY
        CASE r.primary_run_rule
          WHEN 'standalone_wins' THEN IF(REGEXP_CONTAINS(u.run_id, r'X$'), 1, 0)
          ELSE 0
        END,
        IF(r.primary_run_rule = 'latest_wins', u.run_id, '') DESC,
        u.run_id
    ) AS run_rank
  FROM unioned AS u
  JOIN ${CONFIG}.study_registry AS r USING (study_id)
)

SELECT
  study_id, format_id, respondent_id, run_id, source_file, cell_label,
  question_key, meta, question_text, item_text,
  tabulation_kind, response_mode, col_ordinal,
  option_code, option_label,
  option_code IS NOT NULL AS is_valid_response,
  primary_run_rule = 'all_runs' OR run_rank = 1 AS is_primary_run,
  'respondent' AS value_source
FROM ranked
WHERE option_label IS NOT NULL AND option_label != ''
