config {
  type: "table",
  schema: "banner",
  name: "mart_banner_render",
  description: "Printable banner. One row per printed line, one array cell per printed column. Reproduces the #page / Table N / header band / stub / SIGMA layout. Built with joins and ARRAY_AGG rather than correlated subqueries, which BigQuery cannot de-correlate across tables.",
  bigquery: { clusterBy: ["study_id"] },
  tags: ["marts","render"]
}

js { const { CONFIG, PUBLISH_QUEUE } = require("includes/constants"); }

WITH
-- Columns below this base get a * on their heading and a footnote.
-- Suppression (min_base) removes a column entirely; flagging keeps it
-- visible but marks it as too thin to read as a percentage.
small_base AS (
  SELECT r.study_id,
         IFNULL(MAX(CAST(p.param_value AS INT64)), 30) AS threshold
  FROM `archetypeid-staging.banner_config.study_registry` AS r
  LEFT JOIN `archetypeid-staging.banner_config.banner_params` AS p
    ON p.format_id = r.format_id
   AND (p.study_id IS NULL OR p.study_id = r.study_id)
   AND p.param_name = 'small_base_flag'
  GROUP BY r.study_id
),

-- Column spine, ordered as printed. Columns below min_base drop out here
-- so every line comes out the same width.
cols AS (
  SELECT study_id, column_id, banner_group, group_sort,
         cell_label, cell_sort, column_label, column_sort,
         COUNT(DISTINCT respondent_id) AS n_col,
         MAX(IFNULL(min_base, 0)) AS min_base
  FROM ${ref("int_cut_member")}
  WHERE study_id IN (${PUBLISH_QUEUE}) AND is_printed
  GROUP BY 1, 2, 3, 4, 5, 6, 7, 8
),

col_ix AS (
  SELECT study_id, column_id, banner_group, group_sort,
         cell_label, cell_sort, column_label, column_sort, n_col,
         ROW_NUMBER() OVER (PARTITION BY study_id
           ORDER BY group_sort, cell_sort, column_sort, column_label) AS col_ix
  FROM cols
  WHERE n_col >= min_base
),

width AS (
  SELECT study_id, MAX(c.col_ix) AS n_cols
  FROM col_ix AS c GROUP BY study_id
),

-- Table numbering follows questionnaire order.
tables AS (
  SELECT study_id, question_key, meta, question_text, item_text, base_label,
         occurrence,
         DENSE_RANK() OVER (PARTITION BY study_id
           ORDER BY MIN(display_order), question_key) AS table_no
  FROM ${ref("dim_question")}
  WHERE study_id IN (${PUBLISH_QUEUE}) AND tabulation_kind = 'CODED'
  GROUP BY study_id, question_key, meta, question_text, item_text, base_label, occurrence
),

-- ---------------------------------------------------------------
-- Title lines: no cells.
-- ---------------------------------------------------------------
titles AS (
  SELECT t.study_id, t.table_no, k.line_sort, k.line_label,
         CAST(NULL AS STRING) AS line_kind,
         ARRAY<STRING>[] AS cells
  FROM tables AS t
  CROSS JOIN UNNEST([
    STRUCT(1 AS line_sort, '#page' AS line_label),
    STRUCT(2, CONCAT('Table ', CAST(t.table_no AS STRING))),
    STRUCT(3, CONCAT(IFNULL(t.meta,''), '. ', t.question_text,
                     IF(t.item_text IS NULL, '', CONCAT('  ** ', t.item_text, ' **')),
                     IF(t.occurrence > 1,
                        CONCAT('  ** Ask ', CAST(t.occurrence AS STRING), ' **'), ''))),
    STRUCT(4, CONCAT('Base: ', t.base_label))
  ]) AS k
),

-- ---------------------------------------------------------------
-- Header bands: three lines per table, one cell per column.
-- ---------------------------------------------------------------
band AS (
  SELECT
    t.study_id, t.table_no, k.line_sort,
    '' AS line_label,
    k.line_kind,
    ARRAY_AGG(
      CASE k.line_kind
        WHEN 'band_group' THEN IFNULL(c.banner_group, '')
        WHEN 'band_cell'  THEN IFNULL(c.cell_label, '')
        ELSE CONCAT(c.column_label, IF(c.n_col < sb.threshold, ' *', ''))
      END
      ORDER BY c.col_ix
    ) AS cells
  FROM tables AS t
  CROSS JOIN UNNEST([
    STRUCT(5 AS line_sort, 'band_group'  AS line_kind),
    STRUCT(6, 'band_cell'),
    STRUCT(7, 'band_column')
  ]) AS k
  JOIN col_ix AS c ON c.study_id = t.study_id
  JOIN small_base AS sb ON sb.study_id = t.study_id
  GROUP BY t.study_id, t.table_no, k.line_sort, k.line_kind
),

-- ---------------------------------------------------------------
-- Figure lines. The grid is built by joining every stub line to every
-- printed column, then left-joining the actual figure. That keeps the
-- width constant and avoids a correlated lookup.
-- ---------------------------------------------------------------
stub_lines AS (
  SELECT DISTINCT study_id, question_key, stub_key, stub_kind, stub_sort, stub_label
  FROM ${ref("mart_stub")}
  WHERE study_id IN (${PUBLISH_QUEUE})
),

grid AS (
  SELECT k.study_id, k.question_key, k.stub_key, k.stub_kind,
         k.stub_sort, k.stub_label,
         c.column_id, c.col_ix
  FROM stub_lines AS k
  JOIN col_ix AS c ON c.study_id = k.study_id
),

figure_cells AS (
  SELECT
    g.study_id, g.question_key, g.stub_key, g.stub_kind,
    g.stub_sort, g.stub_label, g.col_ix,
    CASE
      WHEN g.stub_kind = 'base' THEN FORMAT('%d', IFNULL(s.n_stub, 0))
      ELSE FORMAT('%.2f%%', IFNULL(s.pct, 0) * 100)
    END AS txt
  FROM grid AS g
  LEFT JOIN ${ref("mart_stub")} AS s
    ON  s.study_id    = g.study_id
    AND s.question_key = g.question_key
    AND s.stub_key     = g.stub_key
    AND s.column_id    = g.column_id
),

figures AS (
  SELECT
    t.study_id, t.table_no,
    10 + f.stub_sort AS line_sort,
    f.stub_label AS line_label,
    f.stub_kind  AS line_kind,
    ARRAY_AGG(f.txt ORDER BY f.col_ix) AS cells
  FROM figure_cells AS f
  JOIN tables AS t
    ON t.study_id = f.study_id AND t.question_key = f.question_key
  GROUP BY t.study_id, t.table_no, f.stub_key, f.stub_sort, f.stub_label, f.stub_kind
),

footnote AS (
  SELECT
    t.study_id, t.table_no,
    99999 AS line_sort,
    CONCAT('* Base under ', CAST(sb.threshold AS STRING),
           '. Percentages shown for information only; read the base, not the percent.') AS line_label,
    'footnote' AS line_kind,
    ARRAY<STRING>[] AS cells
  FROM tables AS t
  JOIN small_base AS sb ON sb.study_id = t.study_id
  WHERE EXISTS (
    SELECT 1 FROM col_ix AS c
    WHERE c.study_id = t.study_id AND c.n_col < sb.threshold
  )
),

all_lines AS (
  SELECT * FROM titles
  UNION ALL SELECT * FROM band
  UNION ALL SELECT * FROM figures
  UNION ALL SELECT * FROM footnote
)

SELECT
  l.study_id, l.table_no, l.line_sort, l.line_label, l.line_kind, l.cells,
  w.n_cols
FROM all_lines AS l
JOIN width AS w ON w.study_id = l.study_id

