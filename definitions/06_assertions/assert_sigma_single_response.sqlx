config {
  type: "assertion",
  schema: "banner_assertions",
  name: "assert_sigma_single_response",
  description: "For single-response questions the option percentages must sum to 1. Tolerance 0.5pp for rounding. Multi-punch questions are excluded by construction.",
  tags: ["dq"]
}

SELECT s.study_id, s.meta, s.question_key, s.column_id,
       ANY_VALUE(s.n_base) AS n_base,
       SUM(s.pct) AS total_pct
FROM ${ref("mart_stub")} AS s
JOIN ${ref("dim_question")} AS q USING (study_id, question_key)
WHERE s.stub_kind = 'option' AND q.response_mode = 'single'
GROUP BY 1, 2, 3, 4
HAVING ABS(SUM(s.pct) - 1.0) > 0.005
